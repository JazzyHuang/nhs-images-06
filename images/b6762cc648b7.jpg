  <defs>
    <style>
      .cls-1, .cls-2, .cls-3 {
        stroke-linejoin: round;
      }

      .cls-1, .cls-2, .cls-3, .cls-4 {
        fill: none;
        stroke-linecap: round;
      }

      .cls-1, .cls-4 {
        stroke: #bababa;
        stroke-width: .72px;
      }

      .cls-5, .cls-6 {
        fill: #000;
      }

      .cls-5, .cls-6, .cls-7 {
        stroke-width: 0px;
      }

      .cls-2 {
        stroke-width: .18px;
      }

      .cls-2, .cls-3 {
        stroke: #000;
      }

      .cls-3 {
        stroke-width: .54px;
      }

      .cls-4 {
        stroke-linejoin: bevel;
      }

      .cls-6 {
        fill-rule: evenodd;
      }

      .cls-7 {
        fill: #fff;
      }
    </style>
  </defs>
