      }

      .cls-2 {
        fill-rule: evenodd;
      }

      .cls-6 {
        stroke-miterlimit: 10;
      }

      .cls-3 {
        fill: #989898;
      }

      .cls-7 {
        stroke: #989898;
      }
    </style>
